       ENCODING EXAMPLE
       # Start with a Unicode string (normal text)
text = "Liberté"

# Encode it to UTF-8 bytes
data = text.encode('utf-8')

print(type(data))  # <class 'bytes'>
print(data)        # b'Libert\xc3


                DECODING EXAMPLE
                # Start with raw bytes (e.g., read from a file)
data = b'Libert\xc3\xa9'

# Decode it back to Unicode
text = data.decode('utf-8')

print(type(text))  # <class 'str'>
print(text)        # Liberté



